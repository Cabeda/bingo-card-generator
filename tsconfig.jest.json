{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "module": "commonjs",
    "moduleResolution": "node16",
    "resolveJsonModule": true,
    "jsx": "react",
    "target": "ES2018",
    "noUncheckedSideEffectImports": false,
    "paths": {
      "@/*": ["./*"]
    }
  }
}
