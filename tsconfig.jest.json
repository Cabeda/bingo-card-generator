{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "module": "CommonJS",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "isolatedModules": true,
    "target": "ES2018",
    "noUncheckedSideEffectImports": false,
    "paths": {
      "@/*": ["./*"]
    }
  }
}
