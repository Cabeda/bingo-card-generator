{
  "name": "bingo-card-generator",
  "version": "0.5.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "build:analyze": "ANALYZE=true next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "NODE_OPTIONS='--experimental-vm-modules' bunx jest",
    "test:game": "NODE_OPTIONS='--experimental-vm-modules' bunx jest --config jest.game.config.cjs --runInBand",
    "test:watch": "NODE_OPTIONS='--experimental-vm-modules' bunx jest --watch",
    "test:coverage": "NODE_OPTIONS='--experimental-vm-modules' bunx jest --coverage",
    "test:i18n": "NODE_OPTIONS='--experimental-vm-modules' bunx jest app/utils/i18n.test.ts app/components/I18nVisualTest.test.tsx",
    "validate:i18n": "node scripts/validate-translations.js",
    "lint:md": "markdownlint-cli2 '**/*.md' '#node_modules'",
    "lint:md:fix": "markdownlint-cli2 --fix '**/*.md' '#node_modules'",
    "prepare": "husky"
  },
  "dependencies": {
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "motion": "^14.9.1",
    "next": "16.4.5",
    "next-intl": "^4.14.9",
    "next-pwa": "^5.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@next/bundle-analyzer": "16.4.5",
    "@tailwindcss/postcss": "^4.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/next-pwa": "^5.6.9",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^10.14.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-config-next": "16.4.5",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "markdownlint-cli2": "^0.24.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.4",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3"
  }
}